{
  "name": "nse-stock-data-server",
  "version": "1.0.0",
  "description": "Node.js server for serving NSE 500 stock data as JSON/CSV via GitHub Pages",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "fetch-historical": "node scripts/fetchHistorical.js",
    "fetch-sample": "node scripts/sample.js",
    "update-daily": "node scripts/updateDaily.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
